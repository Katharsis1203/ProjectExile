+@keyframes hub-snow-drift-near {
+  from {
+    background-position: 0 -160px, 120px -80px;
+  }
+
+  to {
+    background-position: 70px 520px, 20px 660px;
+  }
+}
+
+@keyframes hub-snow-drift-far {
+  from {
+    background-position: 30px -130px, 170px -20px;
+  }
+
+  to {
+    background-position: -30px 510px, 90px 610px;
+  }
+}
+
+.hub-snow-layer {
+  position: absolute;
+  inset: -25%;
+  display: block;
+  background-repeat: repeat;
+  will-change: background-position;
+}
+
+.hub-snow-layer--near {
+  background-image:
+    radial-gradient(circle, rgba(255, 255, 255, 0.95) 0 1.5px, transparent 2px),
+    radial-gradient(circle, rgba(255, 255, 255, 0.72) 0 1px, transparent 1.6px);
+  background-size: 88px 88px, 132px 132px;
+  animation: hub-snow-drift-near 10s linear infinite;
+}
+
+.hub-snow-layer--far {
+  background-image:
+    radial-gradient(circle, rgba(255, 255, 255, 0.55) 0 1px, transparent 1.4px),
+    radial-gradient(circle, rgba(255, 255, 255, 0.4) 0 0.75px, transparent 1.25px);
+  background-size: 66px 66px, 104px 104px;
+  animation: hub-snow-drift-far 16s linear infinite;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .hub-snow-layer {
+    animation: none;
+  }
+}
