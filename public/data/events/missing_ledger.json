  "nodes": {
    "start": {
      "id": "start",
      "title": "The Missing Ledger",
      "text": "Mara, who keeps the Pine & Mug, has misplaced the thin ledger she uses for debts too small to deserve the real book. She is certain it was on the common-room shelf before breakfast.",
      "choices": [
        {
          "type": "checked",
          "text": "Search without turning the inn upside down",
          "statChecks": [
            {
              "stat": "perception",
              "difficulty": 10
            }
          ],
          "weighted": {
            "buckets": [
              {
                "id": "found",
                "threshold": 1,
                "flavourText": "A clean rectangle in the dust shows where the ledger sat. Below it, a chair leg has fresh scrape marks leading toward the stove.",
                "next": "stove",
                "effects": [
                  {
                    "type": "item",
                    "item": "missing_ledger",
                    "amount": 1
                  },
                  {
                    "type": "quest",
                    "quest": "missing_ledger",
                    "stage": "recovered",
                    "objective": "ledger_recovered"
                  }
                ]
              },
              {
                "id": "miss",
                "threshold": 0,
                "flavourText": "The common room contains a hundred plausible hiding places and twice as many distractions.",
                "next": "ask"
              }
            ]
          },
          "effects": [
            {
              "type": "quest",
              "quest": "missing_ledger",
              "stage": "searching"
            }
          ]
        },
        {
          "type": "checked",
          "text": "Use your rope to reach behind the stove",
          "requirements": [
            {
              "type": "item",
              "item": "rope"
            }
          ],
          "statChecks": [
            {
              "stat": "perception",
              "difficulty": 9
